[Unit]
Description=Telegram Signal Copier
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-bots/telegram_copier
EnvironmentFile=/etc/qtp/oanda.env
ExecStart=/home/ubuntu/trading-bots/.venv/bin/python3 /home/ubuntu/trading-bots/telegram_copier/main.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

